# kuramori environment configuration example
# Copy this file to .env and customize values for your local environment:
#   cp .env.example .env

# Server network binding
# By default, kuramori binds strictly to loopback (127.0.0.1) for local security.
HOST=127.0.0.1
PORT=3456

# Storage & Database
DATABASE_URL=file:data/kuramori.db
REPORTS_DIR=./data/reports

# GitHub VCS Provider Integration
# Personal Access Token (PAT) with repo scope for inspecting pull requests and comments.
GITHUB_TOKEN=

# AI Review Engine CLI Paths (optional, defaults to searching in PATH)
CLAUDE_BIN=claude
AGY_BIN=agy
CODEX_BIN=codex
